{
  "_comment": "Loop-tuning compensation baseline (2026-09-01): loop_bowed's skeleton with an SVF lowpass inserted in the cycle (sum -> Shaper -> SVF -> DelayLine) and compensate:true on the delay. The delay walks its loop, finds the SVF, and subtracts tap z^-1 + filter phase delay at f0 per sample (~7.3 samples at note 48 = 95 cents flat if uncompensated). Notes land ON pitch; same graph without compensate is the audible control.",
  "sampleRate": 48000,
  "graph": {
    "nodes": [
      { "id": "__perf_freq", "type": "PerformNode", "params": { "field": "frequency" } },
      { "id": "excite", "type": "SegmentSource",
        "params": { "oneShot": true, "seed": 774001,
                    "values": [2.0, 0.6, 3.0, -0.35, 4.0, 0.15, 6.0, 0.0] } },
      { "id": "bowenv", "type": "Envelope",
        "params": { "preset": "adsr", "attack": 0.03, "decay": 0.15,
                    "sustainLevel": 1.0, "release": 0.25,
                    "minValue": 0.08, "maxValue": 1.15 } },
      { "id": "sum", "type": "CombinedSource",
        "params": { "source1": { "ref": "excite" }, "source2": { "tap": "delay" },
                    "operation": "sum", "gainAdj": 0.0 } },
      { "id": "junction", "type": "Shaper",
        "params": { "source": { "ref": "sum" }, "drive": { "ref": "bowenv" },
                    "smoothness": 0.5,
                    "values": [-1.0, -0.8, -0.5, -0.75, -0.1, -0.5,
                               0.1, 0.5, 0.5, 0.75, 1.0, 0.8] } },
      { "id": "damp", "type": "SVFSource",
        "params": { "source": { "ref": "junction" }, "mode": "Lowpass",
                    "cutoffFreq": 1500.0, "resonance": 0.7 } },
      { "id": "delay", "type": "DelayLine",
        "params": { "source": { "ref": "damp" },
                    "frequency": { "ref": "__perf_freq" }, "ratio": 1.0,
                    "compensate": true } }
    ],
    "output": "delay"
  },
  "instrument": { "polyphony": 2, "volume": 0.5 },
  "score": [ { "note": 48, "time": 0.0, "duration": 1.5, "velocity": 0.8 },
             { "note": 55, "time": 1.8, "duration": 1.5, "velocity": 0.8 },
             { "note": 60, "time": 3.6, "duration": 1.5, "velocity": 0.8 } ]
}
