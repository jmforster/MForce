{
  "sampleRate": 48000,
  "seconds": 6,
  "graph": {
    "nodes": [
      { "id": "saw", "type": "SawSource", "params": { "frequency": 220.0, "amplitude": 1.0 } },
      { "id": "pulse", "type": "PulseSource", "params": { "frequency": 220.0, "amplitude": 1.0, "dutyCycle": 0.3, "bend": 0.4 } },
      { "id": "sin", "type": "SineSource", "params": { "frequency": 220.0, "amplitude": 1.0 } },
      {
        "id": "phased",
        "type": "PhasedValueSource",
        "params": {
          "overlap": 0.15,
          "amplitude": 0.8,
          "stages": [
            { "source": { "ref": "saw" },   "percent": 0.33, "min": 0.5, "max": 3.0, "gain": 1.0 },
            { "source": { "ref": "pulse" }, "percent": 0.33, "min": 0.5, "max": 3.0, "gain": 1.0 },
            { "source": { "ref": "sin" },   "percent": 0,    "min": 0.0, "max": 0.0, "gain": 1.0 }
          ]
        }
      },
      { "id": "ch1", "type": "SoundChannel", "inputs": { "source": "phased" }, "params": { "volume": 0.8, "pan": 0.0 } },
      { "id": "mix", "type": "StereoMixer", "inputs": { "channels": ["ch1"] }, "params": { "gainL": 1.0, "gainR": 1.0 } }
    ],
    "output": "mix"
  }
}
