{
  "sampleRate": 48000, "seconds": 4,
  "graph": { "nodes": [
    { "id": "env", "type": "Envelope", "params": { "preset": "ar", "attack": 0.02 } },
    { "id": "tone", "type": "SineSource", "params": {
        "frequency": 330.0, "amplitude": { "ref": "env" }, "phase": 0.0
    }},
    { "id": "rev", "type": "Reverb", "params": {
        "source": { "ref": "tone" },
        "roomSize": 0.7, "damping": 0.5, "wet": 0.5, "dry": 0.5
    }},
    { "id": "ch1", "type": "SoundChannel", "inputs": { "source": "rev" }, "params": { "volume": 0.8, "pan": 0.0 } },
    { "id": "mix", "type": "StereoMixer", "inputs": { "channels": ["ch1"] }, "params": { "gainL": 1.0, "gainR": 1.0 } }
  ], "output": "mix" }
}
