{
  "sampleRate": 48000,
  "graph": {
    "nodes": [
      {
        "id": "ampEnv",
        "type": "Envelope",
        "params": {
          "stages": [
            { "startVal": 0.0, "endVal": 1.0, "type": "Linear", "power": 0.0, "percent": 0.01, "minSec": 0.003, "maxSec": 0.02 },
            { "startVal": 1.0, "endVal": 0.0, "type": "Expo",   "power": 2.0, "percent": 0.0 }
          ]
        }
      },
      {
        "id": "depthEnv",
        "type": "Envelope",
        "params": {
          "stages": [
            { "startVal": 1.0, "endVal": 0.0, "type": "Expo", "power": 4.0, "percent": 0.0 }
          ]
        }
      },
      {
        "id": "depth",
        "type": "RangeSource",
        "params": { "min": 0.0, "max": 5.0, "var": { "ref": "depthEnv" } }
      },
      {
        "id": "fm",
        "type": "FMSource",
        "params": {
          "frequency":    440.0,
          "amplitude":    { "ref": "ampEnv" },
          "carrierRatio": 1.0,
          "modRatio":     1.0,
          "depth":        { "ref": "depth" },
          "unbounded_pos": false
        }
      }
    ],
    "output": "fm"
  },
  "instrument": {
    "paramMap": { "frequency": "fm.frequency" },
    "polyphony": 6
  }
}
