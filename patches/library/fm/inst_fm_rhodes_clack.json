{
  "sampleRate": 48000,
  "graph": {
    "nodes": [
      {
        "id": "ampBody",
        "type": "Envelope",
        "params": {
          "stages": [
            { "startVal": 0.0, "endVal": 1.0, "type": "Linear", "power": 0.0, "percent": 0.01, "minSec": 0.003, "maxSec": 0.015 },
            { "startVal": 1.0, "endVal": 0.0, "type": "Expo",   "power": 2.0, "percent": 0.0 }
          ]
        }
      },
      {
        "id": "ampTine",
        "type": "Envelope",
        "params": {
          "stages": [
            { "startVal": 0.0, "endVal": 1.0, "type": "Linear", "power": 0.0, "percent": 0.005, "minSec": 0.002, "maxSec": 0.010 },
            { "startVal": 1.0, "endVal": 0.0, "type": "Expo",   "power": 4.0, "percent": 0.0 }
          ]
        }
      },
      {
        "id": "depthBody",
        "type": "Envelope",
        "params": {
          "stages": [
            { "startVal": 1.0, "endVal": 0.3, "type": "Expo", "power": 2.0, "percent": 0.0 }
          ]
        }
      },
      {
        "id": "depthTine",
        "type": "Envelope",
        "params": {
          "stages": [
            { "startVal": 1.0, "endVal": 0.0, "type": "Expo", "power": 3.0, "percent": 0.0 }
          ]
        }
      },
      {
        "id": "depthBodyRange",
        "type": "RangeSource",
        "params": { "min": 0.0, "max": 2.0, "var": { "ref": "depthBody" } }
      },
      {
        "id": "depthTineRange",
        "type": "RangeSource",
        "params": { "min": 0.0, "max": 7.0, "var": { "ref": "depthTine" } }
      },
      {
        "id": "fmBody",
        "type": "FMSource",
        "params": {
          "frequency":    440.0,
          "amplitude":    { "ref": "ampBody" },
          "carrierRatio": 1.0,
          "modRatio":     1.0,
          "depth":        { "ref": "depthBodyRange" },
          "unbounded_pos": false
        }
      },
      {
        "id": "fmTine",
        "type": "FMSource",
        "params": {
          "frequency":    440.0,
          "amplitude":    { "ref": "ampTine" },
          "carrierRatio": 1.0,
          "modRatio":     14.0,
          "depth":        { "ref": "depthTineRange" },
          "unbounded_pos": false
        }
      },
      {
        "id": "clack",
        "type": "SegmentSource",
        "params": {
          "values":     [0.001, 0.0, 0.0015, 1.0, 0.002, 0.0, 0.001, 0.5, 0.002, 0.0, 0.001, 0.25, 0.003, 0.0],
          "amplitude":  1.5,
          "smoothness": 0.6,
          "oneShot":    true
        }
      },
      {
        "id": "mix",
        "type": "MultiSource",
        "params": {
          "source": [
            { "ref": "fmBody", "weight": 0.5 },
            { "ref": "fmTine", "weight": 0.5 },
            { "ref": "clack",  "weight": 0.5 }
          ]
        }
      }
    ],
    "output": "mix"
  },
  "instrument": {
    "paramMap": {
      "frequency": ["fmBody.frequency", "fmTine.frequency"]
    },
    "polyphony": 6
  }
}
