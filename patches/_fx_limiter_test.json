{
  "sampleRate": 48000, "seconds": 2,
  "graph": { "nodes": [
    { "id": "env", "type": "Envelope", "params": { "preset": "ar", "attack": 0.001 } },
    { "id": "hot", "type": "PulseSource", "params": {
        "frequency": 440.0, "amplitude": { "ref": "env" }, "phase": 0.0, "width": 0.5
    }},
    { "id": "lim", "type": "Limiter", "params": {
        "source": { "ref": "hot" },
        "threshold": 0.5, "release": 0.05
    }},
    { "id": "ch1", "type": "SoundChannel", "inputs": { "source": "lim" }, "params": { "volume": 1.0, "pan": 0.0 } },
    { "id": "mix", "type": "StereoMixer", "inputs": { "channels": ["ch1"] }, "params": { "gainL": 1.0, "gainR": 1.0 } }
  ], "output": "mix" }
}
