{
  "_comment": "Module map, phase 1 (describes today's layout). Every tracked C++ source file belongs to exactly one module; a .cpp belongs to its header's module. 'may_include' lists what a module may include. 'file_allowed' lists libraries allowed only in named files: JSON belongs to the serializer files and the tools; every other JSON include is reported.",
  "third_party": {
    "json":    ["nlohmann/", "json.hpp"],
    "imgui":   ["imgui", "imnodes"],
    "rtaudio": ["rtaudio"],
    "rtmidi":  ["rtmidi"],
    "glfw":    ["glfw", "gl/"]
  },
  "file_allowed": {
    "json": [
      "engine/include/mforce/patch/envelope_preset.h",
      "engine/include/mforce/patch/patch_json.h",
      "engine/src/patch/patch_json.cpp",
      "engine/src/patch/node_json.cpp",
      "engine/include/mforce/music/music_json.h",
      "engine/include/mforce/voicing/voicing_json.h",
      "engine/include/mforce/compose/templates_json.h",
      "engine/include/mforce/compose/realization_strategy_json.h",
      "engine/include/mforce/compose/melody_profile_json.h",
      "engine/include/mforce/compose/pool_figure_builder_json.h",
      "engine/src/compose/melody_profile_json.cpp",
      "engine/src/compose/pool_figure_builder_json.cpp",
      "engine/src/compose/style_table_json.cpp",
      "engine/shelved/include/mforce/shelved/connective_passage_strategy_json.h",
      "engine/shelved/include/mforce/shelved/elaborated_phrase_strategy_json.h",
      "engine/shelved/include/mforce/shelved/library_passage_strategy_json.h",
      "engine/shelved/include/mforce/shelved/pedal_buildup_strategy_json.h",
      "engine/shelved/include/mforce/shelved/period_passage_strategy_json.h",
      "engine/shelved/include/mforce/shelved/period_phrase_strategy_json.h",
      "engine/shelved/include/mforce/shelved/sentence_phrase_strategy_json.h",
      "engine/shelved/include/mforce/shelved/sequence_passage_strategy_json.h",
      "engine/shelved/include/mforce/shelved/two_figure_phrase_strategy_json.h",
      "engine/shelved/include/mforce/shelved/wandering_passage_strategy_json.h",
      "engine/shelved/src/pattern_library_json.cpp",
      "engine/src/perform/embedded_score.cpp",
      "tools/"
    ]
  },
  "modules": [
    {"name": "core",   "purpose": "The ValueSource contract and the primitives every node shares; the node registry.",
     "paths": ["engine/include/mforce/core/", "engine/src/component.cpp", "engine/src/source_registry.cpp"], "may_include": []},
    {"name": "contract", "purpose": "The types that cross from performance to realization.",
     "paths": ["engine/include/mforce/contract/"], "may_include": []},
    {"name": "source", "purpose": "Every node type, one folder per family (filter folded in), and the list that registers them.",
     "paths": ["engine/include/mforce/source/", "engine/src/source/"],
     "may_include": ["core"]},
    {"name": "patch",  "purpose": "A patch as data: the records, the declarations a type makes, the codec, the graph build.",
     "paths": ["engine/include/mforce/patch/", "engine/src/patch/"],
     "may_include": ["core", "source"]},
    {"name": "render", "purpose": "Instruments, voices, mixing, a patch built as an instrument or a sound, WAV I/O.",
     "paths": ["engine/include/mforce/render/", "engine/src/render/"],
     "may_include": ["core", "source", "patch", "contract"]},
    {"name": "music",  "purpose": "The value types of music, and their codecs.",
     "paths": ["engine/include/mforce/music/", "engine/src/music/", "engine/src/music.cpp", "engine/src/chord.cpp"], "may_include": ["core"]},
    {"name": "voicing", "purpose": "How a chord symbol is voiced: the voicing selectors and profile selectors, their registry and codec.",
     "paths": ["engine/include/mforce/voicing/"], "may_include": ["core", "music"]},
    {"name": "compose", "purpose": "Composition: templates and their codecs, compose, the strategies, their registry and settings, the figure builders, walkers and profiles.",
     "paths": ["engine/include/mforce/compose/", "engine/src/compose/"], "may_include": ["core", "music", "voicing"]},
    {"name": "shelved", "purpose": "Strategies kept but not built on: registered through register_shelved only.",
     "paths": ["engine/shelved/"], "may_include": ["core", "music", "voicing", "compose"]},
    {"name": "perform", "purpose": "Performance: the conductor and performers, the time map, pitch gestures, the embedded score.",
     "paths": ["engine/include/mforce/perform/", "engine/src/perform/"], "may_include": ["core", "music", "voicing", "contract"]},
    {"name": "play",   "purpose": "One function that runs performance and realization end to end.",
     "paths": ["engine/include/mforce/play/", "engine/src/play/"], "may_include": ["core", "source", "patch", "render", "music", "perform", "contract"]},
    {"name": "util",   "purpose": "Stand-alone analysis helpers (FFT, signal statistics).",
     "paths": ["engine/include/mforce/util/"], "may_include": []},
    {"name": "cli",    "purpose": "mforce_cli, the command-line renderer.",
     "paths": ["tools/mforce_cli/"], "may_include": ["core", "source", "patch", "render", "music", "voicing", "compose", "shelved", "perform", "util", "contract", "play"]},
    {"name": "tests",  "purpose": "engine_tests and test_figures.",
     "paths": ["tools/engine_tests/", "tools/test_figures/", "tools/alloc_probe/", "tools/alloc_gate/", "tools/alloc_gate.py", "tools/tests/"], "may_include": ["core", "source", "patch", "render", "music", "voicing", "compose", "shelved", "perform", "util", "contract", "play"]},
    {"name": "durn",   "purpose": "durn_converter: notation formats to DURN.",
     "paths": ["tools/durn_converter/"], "may_include": ["music"]},
    {"name": "misc_tools", "purpose": "ppl_to_json, stk_ref, wav_check.",
     "paths": ["tools/shelved/ppl_to_json/", "tools/stk_ref/", "tools/wav_check.cpp", "tools/wav_check.c"], "may_include": ["core", "source", "patch", "render", "music", "voicing", "compose", "shelved", "perform", "util", "contract", "play"]}
  ]
}
