# The build rules every MForce target shares, and the one function that
# makes an engine module.
#
# A CMake "function" is called like a command: mforce_compile_rules(mforce_cli).
# It is the one place the language level and the warning rules are written,
# so no target sets its own.

# Gives <target> the compile rules of every MForce target:
#   - C++20, required (a compiler without it fails to configure), with no
#     compiler-specific language extensions;
#   - on MSVC: warning level 4, standard-conforming mode, and every warning
#     treated as an error (/WX), so a warning fails the build.
# The warning flags are written for MSVC only: no other compiler has built
# this tree, so nothing is claimed for one.
function(mforce_compile_rules target)
  set_target_properties(${target} PROPERTIES
    CXX_STANDARD 20
    CXX_STANDARD_REQUIRED ON
    CXX_EXTENSIONS OFF)
  if(MSVC)
    # PRIVATE: these flags compile this target's own files and are not passed
    # on to the targets that link it.
    target_compile_options(${target} PRIVATE /W4 /permissive- /WX)
  endif()
endfunction()

# Makes the engine module <name>, called from the module's own folder
# (engine/<name>/CMakeLists.txt):
#
#   mforce_module(render
#     SOURCES src/mixer.cpp src/voice.cpp ...
#     USES    core source patch contract)
#
# The target is mforce_<name>: a static library built from SOURCES, or, with
# no SOURCES, a header-only target that has nothing to compile and exists to
# hand its folders on. It is given its own include/ folder and, through USES,
# the modules it may use (the may_include list of tools/structure/modules.json;
# a meter test holds the two lists equal). Whatever a used module was given
# passes on in turn, because a header includes the headers of what it uses.
# JSON says the module's own files include nlohmann/json.hpp: the module, and
# every module that uses it, is then given that folder as a system one.
#
# Each module also compiles every header under its include/ in one generated
# file, with the module's own folders and nothing else (mforce_header_check).
function(mforce_module name)
  # cmake_parse_arguments sorts the call's words: JSON is a flag, SOURCES and
  # USES are lists; anything else is a mistake in the call.
  cmake_parse_arguments(PARSE_ARGV 1 arg "JSON" "" "SOURCES;USES")
  if(arg_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "mforce_module(${name}): unknown arguments ${arg_UNPARSED_ARGUMENTS}")
  endif()
  set(target mforce_${name})
  if(arg_SOURCES)
    add_library(${target} STATIC ${arg_SOURCES})
    mforce_compile_rules(${target})
    # PUBLIC: this module's files use the folders, and so does whoever uses it.
    set(reach PUBLIC)
  else()
    add_library(${target} INTERFACE)
    # INTERFACE: nothing of its own to compile; the folders are for its users.
    set(reach INTERFACE)
  endif()
  target_include_directories(${target} ${reach} ${CMAKE_CURRENT_SOURCE_DIR}/include)
  foreach(used IN LISTS arg_USES)
    if(NOT TARGET mforce_${used})
      message(FATAL_ERROR "mforce_module(${name}): USES ${used}, which is not a module made before it")
    endif()
    target_link_libraries(${target} ${reach} mforce_${used})
  endforeach()
  if(arg_JSON)
    target_link_libraries(${target} ${reach} mforce_json)
  endif()
  mforce_header_check(${name})
endfunction()

# Compiles every header under the current folder's include/ in one generated
# file, mforce_<name>_header_check.cpp, as part of the normal build. The file
# is given only what mforce_<name> passes on (its own folders and those of the
# modules it uses) and the compile rules, so a header that includes a module
# its own module may not use fails to compile, whether or not a .cpp of the
# module includes that header.
#
# The list of headers is read again at every build: CONFIGURE_DEPENDS makes
# the build re-run CMake when a header is added or removed. An OBJECT library
# compiles its files and archives nothing (a static library of a file that
# defines nothing draws a librarian warning).
function(mforce_header_check name)
  set(include_dir ${CMAKE_CURRENT_SOURCE_DIR}/include)
  file(GLOB_RECURSE headers CONFIGURE_DEPENDS RELATIVE ${include_dir} ${include_dir}/*.h)
  list(SORT headers)
  set(content "// Generated by mforce_header_check: every header of the ${name} module.\n")
  foreach(header IN LISTS headers)
    string(APPEND content "#include \"${header}\"\n")
  endforeach()
  set(check_file ${CMAKE_CURRENT_BINARY_DIR}/mforce_${name}_header_check.cpp)
  # file(CONFIGURE) rewrites the file only when its text changes, so an
  # unchanged list does not recompile it.
  file(CONFIGURE OUTPUT ${check_file} CONTENT "${content}" @ONLY)
  add_library(mforce_${name}_header_check OBJECT ${check_file})
  target_link_libraries(mforce_${name}_header_check PRIVATE mforce_${name})
  mforce_compile_rules(mforce_${name}_header_check)
endfunction()
